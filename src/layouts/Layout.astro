---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; // 1. IMPORTA IL FOOTER QUI

interface Props {
  title?: string;
}

const { title = "Luna Diving | Premium Thailand Liveaboards" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />

    <slot />

    <Footer />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    /* 3. PICCOLO UPGRADE CSS: */
    min-height: 100vh; /* Cambiato da height: 100% a min-height per gestire correttamente le pagine lunghe */
    display: flex;
    flex-direction: column; /* Spinge automaticamente il footer in fondo allo schermo se la pagina ha poco testo */
  }

  /* Blocca lo scroll della pagina di sfondo quando il menu mobile è aperto */
  body.menu-open {
    overflow: hidden;
  }
</style>