  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-luxury-yacht-foredeck-lounge-drone.webp', 
    text: 'Aerial view over the foredeck of yacht Mami Wata with loungers, bean bags, and deck chairs.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-yacht-bow-view-anchored.webp', 
    text: 'Bow view of classic motor yacht Mami Wata at anchor with guest relaxing on deck.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-motor-yacht-sunset-profile.webp', 
    text: 'Profile side view of classic motor yacht Mami Wata anchored at sunset in calm waters.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-luxury-yacht-double-cabin-interior.webp', 
    text: 'Cozy and luxurious double cabin interior with custom wooden paneling and decorative towel arrangement on yacht Mami Wata.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-yacht-helm-station-sunset.webp', 
    text: 'Classic wooden steering wheel and helm station controls illuminated by warm sunset light on yacht Mami Wata.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-classic-motor-yacht-anchored-tropical-bay.webp', 
    text: 'Stern view of classic motor yacht Mami Wata anchored in a tranquil tropical bay with lush green hills in the background.' 
  },
  { 
    img: '/images/yacht/mami-wata/mami-wata-luxury-yacht-main-saloon-golden-hour.webp', 
    text: 'Warm golden hour sunlight illuminating the elegant teak wood interior and lounge seating of yacht Mami Wata.' 
  }
];

const technicalSpecs = [
  { label: 'Builder', value: 'Halvorsen, Sydney' },
  { label: 'Year of Build', value: '1954' },
  { label: 'Refit', value: '2023' },
  { label: 'Type', value: 'Classic timber motor cruiser' },
  { label: 'Length Overall', value: '15.34 m' },
  { label: 'Beam', value: '4.20 m' },
  { label: 'Cruising Speed', value: '8 to 12 knots' },
  { label: 'Home Port', value: 'Royal Phuket Marina' }
];

const dayCharterRates = [
  {
    name: 'Sunset Cruise (3 Hours)',
    price: '41,000 ฿',
    usd: 'USD 1,250 (Peak: 52,000 ฿ / USD 1,600)',
    location: 'Phuket East Coast',
    details: 'May to Nov / Dec to Apr: 41,000 ฿ | Peak (22 Dec - 5 Jan): 52,000 ฿. Lunch not included.',
    trip: 'Sunset'
  },
  {
    name: 'Rang Yai & Kai Islands (5 Hours)',
    price: '68,000 ฿',
    usd: 'USD 2,100 (High: 73,000 ฿ | Peak: 83,000 ฿)',
    location: 'Local Islands',
    details: 'May-Nov: 68,000 ฿ | Dec-Apr: 73,000 ฿ | Peak: 83,000 ฿ (USD 2,550). Gourmet lunch included.',
    trip: 'Half Day'
  },
  {
    name: 'Phang Nga Bay (8 Hours)',
    price: '83,000 ฿',
    usd: 'USD 2,550 (High: 94,000 ฿ | Peak: 104,000 ฿)',
    location: 'Limestone Karsts',
    details: 'May-Nov: 83,000 ฿ | Dec-Apr: 94,000 ฿ (USD 2,850) | Peak: 104,000 ฿ (USD 3,200). Full day charter.',
    trip: 'Full Day'
  },
  {
    name: 'Krabi, Four Islands (8 Hours)',
    price: '83,000 ฿',
    usd: 'USD 2,550 (High: 94,000 ฿ | Peak: 104,000 ฿)',
    location: 'Andaman Sea',
    details: 'May-Nov: 83,000 ฿ | Dec-Apr: 94,000 ฿ (USD 2,850) | Peak: 104,000 ฿ (USD 3,200). Full day charter.',
    trip: 'Full Day'
  }
];

const overnightRates = [
  {
    name: 'Two Days / One Night',
    price: '170,000 ฿',
    usd: 'USD 5,200 (Dec-Apr: 185,000 ฿ / USD 5,650)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Embark 10:00, disembark 18:30 on final day. Full board and crew included.',
    trip: 'Overnight'
  },
  {
    name: 'Three Days / Two Nights',
    price: '250,000 ฿',
    usd: 'USD 7,600 (Dec-Apr: 265,000 ฿ / USD 8,050)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Extended cruising across Andaman islands with full board and personalized itinerary.',
    trip: 'Overnight'
  },
  {
    name: 'Four Days / Three Nights',
    price: '325,500 ฿',
    usd: 'USD 9,900 (Dec-Apr: 345,000 ฿ / USD 10,500)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Multi-day expedition with complete crew service, meals, and water toys.',
    trip: 'Overnight'
  },
  {
    name: 'Five Days / Four Nights',
    price: '400,000 ฿',
    usd: 'USD 12,150 (Dec-Apr: 415,000 ฿ / USD 12,600)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Deep immersion charter along southern islands and secluded anchorages.',
    trip: 'Overnight'
  },
  {
    name: 'Six Days / Five Nights',
    price: '475,000 ฿',
    usd: 'USD 14,400 (Dec-Apr: 485,000 ฿ / USD 14,700)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Full week island hopping program with custom routing.',
    trip: 'Overnight'
  },
  {
    name: 'Seven Days / Six Nights',
    price: '550,000 ฿',
    usd: 'USD 16,700 (Dec-Apr: 565,000 ฿ / USD 17,150)',
    location: 'Sleeps 6 guests in 2 cabins',
    details: 'Ultimate week-long private charter experience in the Andaman Sea.',
    trip: 'Overnight'
  }
];

const includedItems = [
  'Whole vessel with crew of three: skipper, deckhand and hostess',
  'Day charter hours: 09:00 to 17:00, or 10:00 to 18:00',
  'Gourmet lunch on day charters, full board on overnight charters',
  'Fruit, drinking water, soft drinks, local beer and a bottle of wine',
  'Welcome package with fruit plate and fresh towels',
  'Snorkelling equipment, stand up paddleboard and kayak',
  'Yacht insurance, passenger insurance and local VAT'
];

const notIncludedItems = [
  { text: 'Alcoholic beverages beyond those listed', highlight: 'On request' },
  { text: 'Special catering, therapist, massage and photography', highlight: 'Supplement' },
  { text: 'National park fees where applicable', highlight: 'Direct payment' },
  { text: 'Cancellation, curtailment & liability insurance', highlight: 'Optional' },
  { text: 'Crew gratuities', highlight: 'Discretionary' }
];

const cruisingDistances = [
  { destination: "Phuket East Coast / Rang Yai", distance: "Approx. 8 nm", time: "1 hour" },
  { destination: "Kai Islands", distance: "Approx. 15 nm", time: "1 h 30 min" },
  { destination: "Phang Nga Bay", distance: "Approx. 20 nm", time: "2 hours" },
  { destination: "Krabi Four Islands", distance: "Approx. 30 nm", time: "3 hours" },
  { destination: "Koh Yao Noi / Yai", distance: "Approx. 12 nm", time: "1 h 15 min" }
];

const waterToys = [
  "Snorkelling equipment",
  "Stand up paddleboard (SUP)",
  "Kayak",
  "Fishing rods",
  "Tender with outboard"
];
---

<Layout title={`Classic Halvorsen Motor Yacht ${vesselName} Charter Phuket | Luna Diving`}>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Mami Wata · Halvorsen Cruiser 02</span>
      <h1 class="pcom-title">{vesselName}</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <img 
                src={slide.img} 
                alt={slide.text} 
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">Fifteen metres of Australian timber, twin Cummins and quiet cruising.</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          Fifteen metres of Australian timber, twin Cummins under the floor and a crew of three who have done this a thousand times. She does not go fast and has never needed to. She leaves the marina at eight, finds the anchorage nobody else has bothered with, and comes back at dusk with the teak still warm and the candles already lit.
        </p>

        <h3 class="sub-heading">The Vessel: Halvorsen, 1954</h3>
        <p class="paragraph">
          Mami Wata was built in 1954 by the Halvorsen yard, the Norwegian family firm whose timber cruisers defined Sydney Harbour for half a century. She is fifteen metres of planked hull, teak deck and varnished brightwork, and she carries her age the way good boats do, which is to say quietly.
        </p>
        <p class="paragraph">
          A full refit completed in 2023 brought the systems up to date without touching the character. Twin Cummins diesels, renewed tankage, and a saloon that still has its buttoned leather banquette and its brass instruments on the bulkhead.
        </p>
        <p class="paragraph">
          She works out of Royal Phuket Marina with a crew of three: a skipper who knows this coast in every season, a deckhand, and a hostess who cooks aboard.
        </p>

        <h3 class="sub-heading">Under Way: Eight to Twelve Knots</h3>
        <p class="paragraph">
          Twin 220 horsepower Cummins diesels give a comfortable eight to twelve knots, which is the right speed for this coast. Phang Nga Bay is a morning away and the Kai islands rather less. At anchor she sits still enough that lunch on the foredeck stays on the table.
        </p>

        <h3 class="sub-heading">On Deck: The Foredeck & Wheelhouse</h3>
        <p class="paragraph">
          The foredeck is the whole point of her: teak, four directors chairs, two long sunpads and room enough that eight people are never in each other's way. Parasols go up when the sun gets serious. The beanbags come out after lunch and rarely go away again.
        </p>

        <h3 class="sub-heading">Two Aboard: Proposals and Honeymoons</h3>
        <p class="paragraph">
          There is a version of this boat that takes eight people to a beach for the day, and there is a version that takes two. The second one is quieter. The crew lay the foredeck for dinner while you are still in the water, and then they disappear.
        </p>
        <p class="paragraph">
          Anniversaries, proposals and honeymoons are arranged the same way. Tell us the moment you want and the day is built backwards from it: flowers from the market that morning, an anchorage with nobody in it, a photographer aboard if you want the evidence, and dinner by lamplight on the way home.
        </p>

        <h3 class="sub-heading">Water Toys & Amenities</h3>
        <p class="paragraph">
          Fully equipped for water exploration and relaxed lounging along the Andaman coast:
        </p>
        <ul class="toy-list">
          {waterToys.map(toy => <li>{toy}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Inquire for Mami Wata</h3>
          <p class="sidebar-text">Charter this classic 1954 Halvorsen cruiser out of Royal Phuket Marina for day trips or romantic overnights.</p>
          <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20chartering%20Mami%20Wata." target="_blank" rel="noopener noreferrer" class="pcom-btn-primary">
            Inquire via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Day Charter Pricing Section -->
    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Day Charter Rates</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per Charter, Thai Baht and US Dollar (Conversion at THB 33 to USD 1)</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {dayCharterRates.map((rate) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{rate.name}</h3>
              <span class="cabin-location">{rate.location}</span>
              <p class="cabin-details">{rate.details}</p>
              <span class="cabin-trip-tag">{rate.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{rate.price}</span>
              <span class="price-label">{rate.usd}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="table-note-text" style="margin-top: 16px;">
        * Above eight guests, THB 1,500 (USD 50) per person for full day charters and THB 750 (USD 25) per person for half day charters.<br/>
        * Lunch is not included on the sunset cruise.
      </p>
    </section>

    <!-- Overnight Charter Pricing Section -->
    <section class="pcom-pricing-section">
      <div class="pricing-header">
        <h2 class="content-heading">Overnight Charter Rates</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per Charter, Thai Baht and US Dollar (May to Nov / Dec to Apr)</p>
        <div class="heading-line"></div>
      </div>
      
      <div class="pcom-cabins-list">
        {overnightRates.map((rate) => (
          <div class="cabin-rate-card">
            <div class="cabin-main-info">
              <h3 class="cabin-name">{rate.name}</h3>
              <span class="cabin-location">{rate.location}</span>
              <p class="cabin-details">{rate.details}</p>
              <span class="cabin-trip-tag">{rate.trip}</span>
            </div>
            <div class="cabin-price-zone">
              <span class="price-amount">{rate.price}</span>
              <span class="price-label">{rate.usd}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="table-note-text" style="margin-top: 16px;">
        * Overnight charters embark at 10:00 and disembark at 18:30 on the final day.
      </p>
    </section>

    <!-- Inclusions & Exclusions -->
    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            What the Rate Covers
          </h3>
          <ul class="details-list">
            {includedItems.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not Included
          </h3>
          <ul class="details-list">
            {notIncludedItems.map((item) => (
              <li class="details-item exc-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <div class="exc-text-wrapper">
                  <span class="exc-main-text">{item.text}</span>
                  {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Cruising Grounds Table -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cruising Grounds & Passage Times</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Approximate passage times from Royal Phuket Marina (Indicative dependent on sea state and season).</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Distance</th>
              <th>Cruising Time</th>
            </tr>
          </thead>
          <tbody>
            {cruisingDistances.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-itinerary"><span class="itinerary-text">{row.distance}</span></td>
                <td class="td-route">{row.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <a 
      href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20Mami%20Wata." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider') as HTMLDivElement | null;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', (): void => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  :root {
    --pcom-font: "Next", "Arial Narrow", Arial, sans-serif;
    --pcom-color-canvas: #fff;
    --pcom-color-primary: #010205;
    --pcom-color-surface: #f1f1f4;
    --pcom-color-accent: #008EA7;
    --pcom-color-danger: #b31010;
    --pcom-color-text-muted: #4f5059;
    
    --pcom-space-md: clamp(16px, 1.25vw + 12px, 36px);
    --pcom-space-lg: clamp(32px, 2.75vw + 23px, 76px);
  }

  .pcom-wrapper {
    background-color: var(--pcom-color-canvas);
    min-height: 100vh;
    font-family: var(--pcom-font);
    color: var(--pcom-color-primary);
    width: 100%;
    box-sizing: border-box;
    padding-top: clamp(100px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    align-items: center;
    -webkit-font-smoothing: antialiased;
  }

  /* Hero */
  .pcom-hero {
    width: 100%;
    max-width: 820px;
    padding: 0 var(--pcom-space-md);
    text-align: center;
    margin-bottom: var(--pcom-space-md);
  }

  .pcom-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--pcom-color-accent);
    display: block;
    margin-bottom: 12px;
  }

  .pcom-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    line-height: 1.1;
  }

  .pcom-divider {
    width: 60px;
    height: 2px;
    background-color: var(--pcom-color-primary);
    margin: 0 auto 16px auto;
  }

  .pcom-tagline {
    font-size: clamp(11px, 1.5vw, 13px);
