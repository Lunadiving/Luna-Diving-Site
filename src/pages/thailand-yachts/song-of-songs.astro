---
// src/pages/thailand-yachts/song-of-songs.astro
import Layout from '../../layouts/Layout.astro';

const vesselName = "Song of Songs";
const tagline = "A 42-metre motor yacht built for the long way between anchorages.";

const slideshow = [
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-luxury-superyacht-stern-twilight.webp', 
    text: 'Aerial twilight view of the Song of Songs superyacht anchored with blue underwater LED lights, tender, jet skis, and water toys' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-superyacht-profile-sunset-phuket.webp', 
    text: 'Side profile view of the 116ft Song of Songs luxury superyacht cruising at sunset off Phuket with water toys alongside' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-aft-deck-beach-club-dusk.webp', 
    text: 'Stern and beach club platform of the Song of Songs superyacht illuminated with blue LED lighting at dusk' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-suite-interior.webp', 
    text: 'Spacious master suite cabin with king-size bed, elegant ambient lighting, desk, and light wood finishes aboard Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-ensuite-bathroom-marble.webp', 
    text: 'Luxury master ensuite bathroom featuring marble vanities, modern fixtures, and glass shower enclosure' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-vip-cabin-double-bed.webp', 
    text: 'Opulent VIP cabin suite with plush double bed, warm accent lighting, and decorative throw blanket' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-twin-guest-cabin.webp', 
    text: 'Modern twin guest cabin with two single beds, custom lighting, and stylish interior finishes on Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-upper-deck-alfresco-dining.webp', 
    text: 'Covered upper deck alfresco dining area elegantly set for dinner with blue mood lighting and plush seating' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-main-deck-salon-lounge.webp', 
    text: 'Panoramic main deck saloon with contemporary white sofas, large TV screen, and floor-to-ceiling windows' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-formal-dining-room-chandelier.webp', 
    text: 'Elegant formal dining room featuring a marble table, crystal chandelier, and large windows with ocean views aboard Song of Songs' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-master-stateroom-panoramic-view.webp', 
    text: 'Master stateroom suite with king bed, lounge seating, large TV screen, and panoramic ocean view balcony doors' 
  },
  { 
    img: '/images/yacht/song-of-songs/song-of-songs-foredeck-jacuzzi-sunpad-lounge.webp', 
    text: 'Guests relaxing in the foredeck Jacuzzi hot tub surrounded by sunpads and lounge seating on Song of Songs' 
  }
];

const technicalSpecs = [
  { label: 'Builder', value: 'Heysea Yachts (Asteria 142)' },
  { label: 'Year Built', value: '2022' },
  { label: 'Length Overall', value: '42.27 m' },
  { label: 'Beam', value: '8.50 m' },
  { label: 'Draft', value: '1.97 m' },
  { label: 'Engines', value: '2 x Caterpillar C-32' },
  { label: 'Cruising Speed', value: '10 knots' },
  { label: 'Maximum Speed', value: '15 knots' },
  { label: 'Cruising Range', value: '2,000+ Nautical Miles' },
  { label: 'Cabins', value: '6 (1 Master, 2 VIP, 3 Guest)' },
  { label: 'Guests Overnight', value: '12 Guests' },
  { label: 'Guests Day Charter', value: '20 Guests Max' },
  { label: 'Fuel Capacity', value: '26,300 L' },
  { label: 'Fresh Water', value: '5,000 L' },
  { label: 'Home Port', value: 'Ao Po Grand Marina, Phuket' }
];

const packageRates = [
  { type: 'Day Charter (8 Hours)', priceUSD: '$37,500', notes: 'Up to 12 guests. All inclusive rate.' },
  { type: 'Two Full Days, One Night', priceUSD: '$46,000', notes: 'Up to 12 guests. All inclusive rate.' }
];

const packageSupplements = [
  { item: 'Additional Guest above 12', rate: '$600 per person' },
  { item: 'Premium Food & Beverage Supplement (Day Charter)', rate: '$2,500' },
  { item: 'Premium Food & Beverage Supplement (Two Day Package)', rate: '$5,000' }
];

const nightlyWorkedExample = [
  { item: 'Charter Fee (7 Nights @ $25,000 / night)', amount: '$175,000' },
  { item: 'Tax (15% for Thai waters)', amount: '$26,250' },
  { item: 'Advance Provisioning Allowance (APA 25%)', amount: '$43,750' },
  { item: 'Total Payable Before Departure', amount: '$245,000' }
];

const includedInPackage = [
  'Captain, engineer and professional crew',
  'Two Sea-Doo jet skis, paddleboards, wakeboard, waterskis and snorkelling gear',
  'Champagne, Prosecco, house wines, cocktails and all beverages',
  'All meals, snacks and refreshments',
  'Fuel for cruising and for water sports',
  'National park permits and conservation fees',
  'Airport transfers on arrival and departure',
  'Satellite communications and Wi-Fi'
];

const includedInNightly = [
  'Captain, engineer and full professional crew',
  'Use of the vessel and of all water toys carried aboard',
  'Full access to all decks, Jacuzzi, and guest staterooms'
];

const metFromApa = [
  'All meals, snacks, and requested beverages',
  'Fuel for the duration of the charter and generators',
  'Excursions, local guide fees, and park permits',
  'Clearances and conservation fees',
  'Airport transfers',
  'Satellite communications and Wi-Fi',
  'Marina dockage and berthing fees'
];

const chargedSeparately = [
  { text: 'International and domestic airfares', highlight: 'Excluded' },
  { text: 'Excess baggage and airport taxes', highlight: 'Excluded' },
  { text: 'Travel insurance and personal expenses', highlight: 'Excluded' },
  { text: 'Spa and massage treatments on board or ashore', highlight: 'On Request' },
  { text: 'Crew gratuities (discretionary, typically 10% to 15%)', highlight: 'Discretionary' },
  { text: 'Unscheduled excursions & drone usage fees', highlight: 'Extra' },
  { text: 'Seabobs, e-foils & additional water sports equipment rental', highlight: 'On Request' },
  { text: 'Scuba diving, dive gear, tank rental and instruction', highlight: 'On Request' }
];

const cruisingGrounds = [
  { destination: 'Phang Nga Bay', country: 'Thailand', type: 'Day & Overnight' },
  { destination: 'Phi Phi Islands', country: 'Thailand', type: 'Day & Overnight' },
  { destination: 'Krabi and Koh Lanta', country: 'Thailand', type: 'Overnight' },
  { destination: 'Similan and Surin Islands', country: 'Thailand', type: 'Overnight' },
  { destination: 'Mergui Archipelago', country: 'Myanmar', type: 'Expedition Passage' },
  { destination: 'Langkawi', country: 'Malaysia', type: 'Cross-Border Charter' }
];

const waterToysList = [
  "Two Sea-Doo Jet Skis",
  "Tender",
  "Three Stand-Up Paddleboards (SUP)",
  "Floating Sea Platform",
  "Wakeboard & Waterskis",
  "Snorkelling Equipment"
];
---

<Layout title={`Song of Songs 42m Superyacht Charter Phuket | Luna Diving`}>
  <main class="pcom-wrapper">
    
    <section class="pcom-hero">
      <span class="pcom-subtitle">Heysea Asteria 142 Superyacht</span>
      <h1 class="pcom-title">{vesselName}</h1>
      <div class="pcom-divider"></div>
      <p class="pcom-tagline">{tagline}</p>
    </section>

    <section class="pcom-specs-container">
      <div class="pcom-specs-grid">
        {technicalSpecs.map((spec) => (
          <div class="spec-item">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="pcom-gallery-section">
      <div class="gallery-slider-outer">
        <div id="slider" class="gallery-slider-inner no-scrollbar">
          {slideshow.map((slide, index) => (
            <div class="gallery-slide">
              <img 
                src={slide.img} 
                alt={slide.text} 
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="gallery-caption">
                <span class="caption-count">Vessel Tour {index + 1} / {slideshow.length}</span>
                <p class="caption-text">{slide.text}</p>
              </div>
            </div>
          ))}
        </div>

        <button id="prevBtn" class="nav-button prev" aria-label="Previous">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg>
        </button>
        <button id="nextBtn" class="nav-button next" aria-label="Next">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
        </button>
      </div>
    </section>

    <section class="pcom-content-grid">
      <div class="content-main">
        <h2 class="content-heading">A 42-metre motor yacht built for the long way between anchorages.</h2>
        <div class="heading-line"></div>
        <p class="paragraph">
          Delivered by Heysea in 2022, Song of Songs carries twelve guests in six cabins over three decks, with an upper-deck master, two VIP suites and three guest cabins. Two Caterpillar C-32s and 26,300 litres of fuel give her better than two thousand nautical miles between fuel stops, which is what it takes to cruise this part of the world properly.
        </p>

        <h3 class="sub-heading">Under Way & Performance</h3>
        <p class="paragraph">
          Two Caterpillar C-32s, ten knots of cruising speed and fuel for better than two thousand nautical miles. Song of Songs is built to leave the marina behind for a fortnight and think nothing of it.
        </p>

        <h3 class="sub-heading">The Sun Deck</h3>
        <p class="paragraph">
          The top deck belongs to the guests: a shaded table long enough for the whole party, loungers in the open, and the best view aboard. Dinner is served up here more often than below. The hardtop holds the sun off through the afternoon and the table seats twelve.
        </p>

        <h3 class="sub-heading">The Aft Deck & Swim Platform</h3>
        <p class="paragraph">
          Two tables, a long sofa and the wake running out behind, with the swim platform a flight of steps below. The garage opens at the stern, so the tender and the jet skis come out onto the platform without anyone crossing the deck.
        </p>

        <h3 class="sub-heading">The Upper Deck & Jacuzzi</h3>
        <p class="paragraph">
          A jacuzzi set flush into the deck forward of the master suite, and a private terrace aft of it with the sunset on it. Nothing sits forward of the jacuzzi but the bow, which makes it the best seat aboard at anchor.
        </p>

        <h3 class="sub-heading">The Main Saloon & Dining Room</h3>
        <p class="paragraph">
          The saloon runs most of the beam, pale and low-lit, with the sea alongside it through full-height glass. The bar sits at the aft end, beside the doors, so nobody crosses the room with a tray.
        </p>
        <p class="paragraph">
          In the dining room, a marble table sits under a glass chandelier, laid alongside full-height windows, with the deck doors open when the evening allows. The professional galley is separate and clear of guest routes, making seamless service for twelve possible at anchor.
        </p>

        <h3 class="sub-heading">The Master Suite & Guest Accommodation</h3>
        <p class="paragraph">
          The master suite commands the upper deck: a private terrace aft, a sitting area, and glass on three sides of the berth. Marble bathrooms feature twin basins and a walk-in shower in the principal suites.
        </p>
        <p class="paragraph">
          Five cabins beyond the master are arranged so that nobody in the party ends up with the difficult one. Two VIP suites and three guest cabins take the balance of twelve guests, each with its own ensuite bathroom and natural light.
        </p>

        <h3 class="sub-heading">Toys & On-Board Amenities</h3>
        <ul class="toy-list">
          {waterToysList.map(toy => <li>{toy}</li>)}
        </ul>
      </div>

      <div class="content-sidebar">
        <div class="booking-sticky-box">
          <h3 class="sidebar-heading">Inquire for Song of Songs</h3>
          <p class="sidebar-text">Experience ultimate 42-metre luxury charter out of Ao Po Grand Marina, Phuket.</p>
          <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20chartering%20Song%20of%20Songs." target="_blank" rel="noopener noreferrer" class="pcom-btn-primary">
            Inquire via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing Structure 1: All Inclusive Packages -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Structure 1: All Inclusive Packages</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Single fixed price. Up to 12 guests. Includes crew, meals, beverages, fuel, water sports, park fees & airport transfers.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Package Duration</th>
              <th>Rate (USD)</th>
              <th>Details</th>
              <th class="table-action-header">Action</th>
            </tr>
          </thead>
          <tbody>
            {packageRates.map((row) => (
              <tr>
                <td class="td-dates">{row.type}</td>
                <td class="td-itinerary"><strong>{row.priceUSD}</strong></td>
                <td class="td-route">{row.notes}</td>
                <td class="td-action">
                  <a href={`https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20Song%20of%20Songs%20for%20${encodeURIComponent(row.type)}.`} target="_blank" rel="noopener noreferrer" class="table-book-btn">
                    Book
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style="margin-top: 20px;">
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Package Supplements & Upgrades</h4>
        <div class="table-responsive-container">
          <table class="schedule-table">
            <thead>
              <tr>
                <th>Supplement Item</th>
                <th>Rate (USD)</th>
              </tr>
            </thead>
            <tbody>
              {packageSupplements.map((sup) => (
                <tr>
                  <td class="td-dates">{sup.item}</td>
                  <td class="td-itinerary"><strong>{sup.rate}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="table-note-text" style="margin-top: 12px; font-size: 12px; color: #4f5059; line-height: 1.5;">
        * Standard rate includes all meals, Champagne, Prosecco, house wines and classic bar.<br/>
        * Premium supplement upgrades to luxury Champagne, premium wines and top-shelf bar service.
      </p>
    </section>

    <!-- Pricing Structure 2: Nightly Charter & APA -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Structure 2: Nightly Charter (Superyacht Terms)</h2>
        <p class="paragraph" style="margin-bottom: 8px;">Per 24 hours (Noon to Noon) · $25,000 USD / night for up to 12 guests + Tax + APA.</p>
        <div class="heading-line"></div>
      </div>

      <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Worked Example: 7-Night Charter</h4>
      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Cost Item</th>
              <th>Amount (USD)</th>
            </tr>
          </thead>
          <tbody>
            {nightlyWorkedExample.map((row) => (
              <tr>
                <td class="td-dates">{row.item}</td>
                <td class="td-itinerary"><strong>{row.amount}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note-text" style="margin-top: 12px; font-size: 12px; color: #4f5059; line-height: 1.5;">
        * Advance Provisioning Allowance (APA) is a prepayment against running costs (typically 20–30%). The captain meets fuel, provisioning, dockage and shore costs from it and provides an itemized expense report at charter end. Any balance is refunded or shortfall settled.
      </p>
    </section>

    <!-- Inclusions & Terms Comparison -->
    <section class="pcom-details-grid-section">
      <div class="details-split-container">
        <div class="details-column included-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            In the All-Inclusive Package Rate
          </h3>
          <ul class="details-list">
            {includedInPackage.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="details-column excluded-box">
          <h3 class="details-col-title">
            <svg class="title-icon icon-inc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Nightly Rate & APA Breakdown
          </h3>
          <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">In the Nightly Charter Fee:</p>
          <ul class="details-list" style="margin-bottom: 16px;">
            {includedInNightly.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-inc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Drawn from APA Allowance:</p>
          <ul class="details-list">
            {metFromApa.map((item) => (
              <li class="details-item">
                <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Charged Separately Section -->
    <section class="pcom-details-grid-section">
      <div class="details-column" style="width: 100%; box-sizing: border-box;">
        <h3 class="details-col-title">
          <svg class="title-icon icon-exc" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Charged Separately (Both Structures)
        </h3>
        <ul class="details-list">
          {chargedSeparately.map((item) => (
            <li class="details-item exc-item">
              <svg class="item-dot dot-exc" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
              <div class="exc-text-wrapper">
                <span class="exc-main-text">{item.text}</span>
                {item.highlight && <span class="exc-highlight">{item.highlight}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Cruising Grounds Section -->
    <section class="pcom-schedule-section">
      <div class="pricing-header">
        <h2 class="content-heading">Cruising Grounds & Ranges</h2>
        <p class="paragraph" style="margin-bottom: 12px;">Operating out of Ao Po Grand Marina across Thailand, Myanmar & Malaysia.</p>
        <div class="heading-line"></div>
      </div>

      <div class="table-responsive-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Region</th>
              <th>Charter Type</th>
            </tr>
          </thead>
          <tbody>
            {cruisingGrounds.map((row) => (
              <tr>
                <td class="td-dates">{row.destination}</td>
                <td class="td-itinerary">{row.country}</td>
                <td class="td-route">{row.type}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <a 
      href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20booking%20the%20Song%20of%20Songs%20Superyacht." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="pcom-whatsapp-float"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const slider = document.getElementById('slider');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  if (slider && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft + slideWidth >= slider.scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', () => {
      const slideWidth = slider.clientWidth;
      if (slider.scrollLeft <= 0) {
        slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
      } else {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  :root {
    --pcom-font: "Next", "Arial Narrow", Arial, sans-serif;
    --pcom-color-canvas: #fff;
    --pcom-color-primary: #010205;
    --pcom-color-surface: #f1f1f4;
    --pcom-color-accent: #008EA7;
    --pcom-color-danger: #b31010;
    --pcom-color-text-muted: #4f5059;
    
    --pcom-space-md: clamp(16px, 1.25vw + 12px, 36px);
    --pcom-space-lg: clamp(32px, 2.75vw + 23px, 76px);
  }

  .pcom-wrapper {
