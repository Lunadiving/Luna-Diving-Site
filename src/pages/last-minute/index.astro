---
// src/pages/last-minute/index.astro
import Layout from '../../layouts/Layout.astro';
import deals from '../../data/deals.json';

const title = "Last Minute & Special Deals on Thailand Liveaboards | Luna Diving";
const whatsappNumber = "66918233120";
---

<Layout title={title}>
  <main class="deals-container">
    <section class="hero-section">
      <h1>Dive Deep and Save Big: Last Minute & Special Deals!</h1>
      <p class="subtitle">Dreaming of exploring the breathtaking underwater world of Thailand? Grab your spot on our upcoming liveaboard departures!</p>
    </section>

    <!-- DYNAMIC DEALS GRID -->
    <section class="deals-grid">
      {deals.length > 0 ? (
        deals.map((deal) => (
          <div class="deal-card">
            {deal.badge && <span class="badge">{deal.badge}</span>}
            <div class="deal-header">
              <h3>{deal.title}</h3>
              <span class="vessel-name">
                Vessel: 
                {deal.vesselUrl ? (
                  <a href={deal.vesselUrl} class="vessel-link">{deal.vessel}</a>
                ) : (
                  <strong>{deal.vessel}</strong>
                )}
              </span>
            </div>
            
            <ul class="deal-details">
              <li>📅 <strong>Dates:</strong> {deal.dates}</li>
              <li>🗺️ <strong>Route:</strong> {deal.route}</li>
              {deal.cabinType && <li>👥 <strong>Cabin:</strong> {deal.cabinType}</li>}
              <li>⚡ <strong>Availability:</strong> <span class="highlight">{deal.spotsLeft}</span></li>
            </ul>

            <div class="pricing-box">
              <div>
                <span class="old-price">{deal.originalPrice}</span>
                <span class="current-price">{deal.price}</span>
              </div>
              <a 
                href={`https://wa.me/${whatsappNumber}?text=Hi%20Luna%20Diving!%20I'm%20interested%20in%20the%20last%20minute%20deal:%20${encodeURIComponent(deal.title)} (${deal.dates})`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-book"
              >
                Book via WhatsApp
              </a>
            </div>
          </div>
        ))
      ) : (
        <div class="no-deals card">
          <h3>No Last Minute Deals Right Now</h3>
          <p>Check back soon or contact us directly to plan your custom dive trip!</p>
        </div>
      )}
    </section>

    <section class="cta-section">
      <h2>Have a specific date in mind?</h2>
      <p>Browse our schedule or contact our team directly for custom inquiries and private charters.</p>
      <a href={`https://wa.me/${whatsappNumber}?text=Hi%20Luna%20Diving!%20I%20would%20like%20to%20know%20more%20about%20your%20available%20liveaboard%20trips.`} target="_blank" rel="noopener noreferrer" class="btn-whatsapp-large">
        Chat on WhatsApp Now
      </a>
    </section>
  </main>
</Layout>

<style>
  .deals-container { 
    max-width: 1100px; 
    margin: 120px auto 60px auto; 
    padding: 0 20px; 
    font-family: 'Inter', sans-serif; 
  }

  .hero-section { text-align: center; margin-bottom: 40px; }
  h1 { font-size: clamp(2rem, 4vw, 2.6rem); color: #0b131f; margin-bottom: 10px; font-weight: 800; }
  .subtitle { font-size: 1.1rem; color: #555; max-width: 700px; margin: 0 auto; line-height: 1.6; }
  
  .deals-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
    gap: 30px; 
    margin-bottom: 50px; 
  }

  /* FIXED CARD PADDING & BADGE POSITIONING */
  .deal-card { 
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0; 
    border-radius: 12px; 
    padding: 55px 25px 25px 25px; /* Increased top padding so titles don't overlap the badge */
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .deal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  }

  .badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #ff4757;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    z-index: 10;
  }

  .deal-header h3 { color: #0c3562; margin: 0 0 5px 0; font-size: 1.3rem; line-height: 1.3; }
  .vessel-name { font-size: 0.9rem; color: #64748b; display: block; margin-bottom: 20px; }
  
  .vessel-link {
    color: #0c3562;
    font-weight: 700;
    text-decoration: underline;
  }
  .vessel-link:hover {
    color: #00b074;
  }

  .deal-details { list-style: none; padding: 0; margin: 0 0 25px 0; display: flex; flex-direction: column; gap: 10px; }
  .deal-details li { font-size: 0.95rem; color: #333; }
  .highlight { color: #00b074; font-weight: 700; }

  .pricing-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f1f5f9;
    padding-top: 20px;
    margin-top: auto;
  }

  .old-price { display: block; font-size: 0.85rem; color: #94a3b8; text-decoration: line-through; }
  .current-price { font-size: 1.3rem; font-weight: 800; color: #0c3562; }

  .btn-book { 
    background: #00b074; 
    color: #fff; 
    text-decoration: none; 
    font-weight: 700; 
    font-size: 0.85rem;
    padding: 10px 16px; 
    border-radius: 6px; 
    transition: background 0.2s;
  }
  .btn-book:hover { background: #009662; }

  .cta-section { text-align: center; padding: 40px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; }
  .cta-section h2 { margin: 0 0 10px 0; color: #0b131f; font-size: 1.5rem; }
  .cta-section p { color: #64748b; margin-bottom: 20px; }

  .btn-whatsapp-large { 
    display: inline-block; 
    background: #25d366; 
    color: #fff; 
    font-weight: 700; 
    padding: 12px 24px; 
    border-radius: 6px; 
    text-decoration: none; 
    transition: background 0.2s;
  }
  .btn-whatsapp-large:hover { background: #20ba5a; }

  @media (max-width: 768px) {
    .deals-container { margin-top: 90px; }
    .pricing-box { flex-direction: column; align-items: flex-start; gap: 15px; }
    .btn-book { width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>