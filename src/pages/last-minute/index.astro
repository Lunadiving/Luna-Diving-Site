---
// src/pages/last-minute/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const title = "Last Minute & Special Deals on Thailand Liveaboards";
---

<Layout title={title}>
  <Header />

  <main class="deals-container">
    <section class="hero-section">
      <h1>Dive Deep and Save Big: Last Minute & Special Deals!</h1>
      <p class="subtitle">Dreaming of exploring the breathtaking underwater world of Thailand? Look no further!</p>
    </section>

    <section class="content-grid">
      <div class="card">
        <h3>Dive into Paradise at Discounted Prices</h3>
        <ul>
          <li><strong>Limited-time offers</strong> on popular destinations: Similan Islands, Surin Islands, and Richelieu Rock!</li>
          <li><strong>Unbeatable savings</strong> on multi-day diving excursions.</li>
          <li>Don’t miss out! These deals are subject to availability and won't last forever.</li>
        </ul>
      </div>

      <div class="card">
        <h3>Experience the Ultimate Adventure</h3>
        <ul>
          <li><strong>Luxurious accommodations:</strong> Comfortable cabins, delicious meals, and top-notch service.</li>
          <li><strong>Expertly Guided:</strong> Maximize your time with guides leading you to the best sites.</li>
          <li><strong>Diverse marine life:</strong> Encounter manta rays, whale sharks, and vibrant reefs.</li>
        </ul>
      </div>
    </section>

    <section class="cta-section">
      <h2>Ready to embark?</h2>
      <p>Browse our current availability below or contact us to secure your spot.</p>
      <a href="https://wa.me/YOUR_NUMBER" class="btn-book">Contact Luna Diving Thailand</a>
    </section>
  </main>
</Layout>

<style>
  /* Distanza aumentata per non far coprire il titolo dall'header fisso */
  .deals-container { 
    max-width: 1000px; 
    margin: 100px auto 40px auto; 
    padding: 0 20px; 
    font-family: sans-serif; 
  }

  .hero-section { text-align: center; margin-bottom: 50px; }
  h1 { font-size: 2.5rem; color: #000; margin-bottom: 10px; }
  .subtitle { font-size: 1.2rem; color: #555; }
  
  .content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 50px; }
  .card { padding: 30px; border: 1px solid #eee; border-radius: 8px; background: #fafafa; }
  .card h3 { color: #008EA7; margin-bottom: 15px; }
  .card ul { padding-left: 20px; }
  .card li { margin-bottom: 10px; line-height: 1.6; }
  
  .cta-section { text-align: center; padding: 40px; background: #f0f8fa; border-radius: 8px; }
  .btn-book { 
    display: inline-block; 
    padding: 15px 30px; 
    background: #008EA7; 
    color: #fff; 
    text-decoration: none; 
    font-weight: bold; 
    border-radius: 5px; 
    margin-top: 20px; 
  }

  /* Adattamento mobile */
  @media (max-width: 768px) {
    .deals-container { margin-top: 80px; }
    .content-grid { grid-template-columns: 1fr; }
    h1 { font-size: 1.8rem; }
  }
</style>