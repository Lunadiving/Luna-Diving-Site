---
// Clean slate for Diving Itineraries Page
import Layout from '../../layouts/Layout.astro'; 

const itineraries = [
  {
    title: "Similan & Surin Islands Liveaboard",
    duration: "4 Days / 4 Nights",
    destinations: "Similan, Koh Bon, Koh Tachai, Richelieu Rock",
    type: "Liveaboard",
    description: "Our most popular route. Explore the breathtaking granite boulders of the Similans and the world-class macro life and pelagics at Richelieu Rock.",
    highlights: ["Up to 14 dives included", "En-suite AC cabins", "All meals and snacks freshly prepared", "Nitrox available on board"]
  },
  {
    title: "Southern Andaman Liveaboard",
    duration: "3 Days / 2 Nights",
    destinations: "Hin Daeng, Hin Muang, Koh Haa, Phi Phi",
    type: "Liveaboard",
    description: "Dive the dramatic vertical walls of the south. Famous for vibrant soft corals, steep drop-offs, and frequent manta ray sightings.",
    highlights: ["Up to 10 dives included", "Less crowded dive sites", "Spectacular limestone caverns", "Comfortable cruising"]
  },
  {
    title: "Best of the Andaman Sea",
    duration: "7 Days / 7 Nights",
    destinations: "Similan to Hin Daeng (Full Route)",
    type: "Extended Liveaboard",
    description: "The ultimate Thailand diving adventure. Cover both the Northern and Southern routes in one seamless trip to experience everything the Andaman Sea has to offer.",
    highlights: ["Up to 25 dives included", "Complete marine biodiversity", "Premium cabin upgrades", "Free Nitrox for certified divers"]
  },
  {
    title: "Phi Phi & Shark Point Premium Day Trip",
    duration: "Full Day (3 Dives)",
    destinations: "Koh Phi Phi, Shark Point, Anemone Reef",
    type: "Day Trip",
    description: "A fantastic day trip for those staying in Phuket or Khao Lak. Explore colorful anemone fields, limestone walls, and look for resting leopard sharks.",
    highlights: ["3 spectacular boat dives", "Hotel transfers included", "Breakfast and lunch on board", "Small group ratios (Max 4:1)"]
  }
];
---

<Layout title="Diving Itineraries & Liveaboards | Luna Diving Thailand">
  <main class="itineraries-page">
    
    <section class="hero-section">
      <div class="container">
        <span class="subtitle">LIVEABOARDS & DAY TRIPS</span>
        <h1>Unforgettable Diving Itineraries</h1>
        <p class="hero-text">
          Whether you are looking for a quick day trip to local reefs or a multi-day liveaboard cruise to the Similan Islands, we have the perfect schedule for your next underwater adventure.
        </p>
      </div>
    </section>

    <section class="itineraries-section">
      <div class="container">
        <div class="itineraries-grid">
          {itineraries.map(itinerary => (
            <div class="itinerary-card">
              <div class="card-header">
                <span class="itinerary-type">{itinerary.type}</span>
                <h2 class="itinerary-title">{itinerary.title}</h2>
                <div class="itinerary-meta">
                  <span class="meta-item">⏱️ {itinerary.duration}</span>
                  <span class="meta-item destination">📍 {itinerary.destinations}</span>
                </div>
              </div>
              
              <div class="card-body">
                <p class="itinerary-desc">{itinerary.description}</p>
                <ul class="features-list">
                  {itinerary.highlights.map(highlight => (
                    <li>✨ {highlight}</li>
                  ))}
                </ul>
              </div>
              
              <div class="card-footer">
                <a href="/contact" class="btn-primary">Check Availability</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2>Need help choosing the right trip?</h2>
          <p>Our schedules fill up fast during the high season. Contact us with your preferred travel dates and we will find the perfect itinerary for your experience level.</p>
          <a href="/contact" class="btn-secondary">Message us on WhatsApp</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .itineraries-page {
    padding-top: clamp(120px, 10vw, 160px);
    background-color: #fbfbfc;
    color: #010205;
    font-family: Arial, sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-section {
    text-align: center;
    padding-bottom: 60px;
  }

  .subtitle {
    font-size: 11px;
    letter-spacing: 4px;
    color: #008EA7;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.5px;
    margin: 0 0 20px 0;
    line-height: 1.15;
  }

  .hero-text {
    max-width: 700px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.6;
    color: #50555c;
  }

  .itineraries-section {
    padding: 40px 0 80px 0;
  }

  .itineraries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 32px;
  }

  .itinerary-card {
    background: #ffffff;
    border: 1px solid #eef0f3;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .itinerary-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(1, 2, 5, 0.04);
  }

  .itinerary-type {
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    color: #008EA7;
    background: rgba(0, 142, 167, 0.08);
    padding: 4px 12px;
    border-radius: 20px;
    display: inline-block;
    letter-spacing: 1px;
  }

  .itinerary-title {
    font-size: 22px;
    margin: 16px 0;
    font-weight: 700;
  }

  .itinerary-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px dashed #eef0f3;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 600;
    color: #40444b;
  }

  .destination {
    color: #71777f;
    font-weight: 400;
  }

  .itinerary-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #40444b;
    margin-bottom: 24px;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    color: #50555c;
  }

  .btn-primary {
    display: block;
    text-align: center;
    background-color: #010205;
    color: #ffffff;
    text-decoration: none;
    padding: 14px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #008EA7;
  }

  .cta-section {
    padding-bottom: 80px;
  }

  .cta-box {
    background-color: #010205;
    color: #ffffff;
    padding: 60px 40px;
    border-radius: 16px;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-box h2 {
    font-size: 28px;
    margin-top: 0;
  }

  .cta-box p {
    color: #a0a5ad;
    max-width: 500px;
    margin: 16px auto 32px auto;
    line-height: 1.6;
  }

  .btn-secondary {
    display: inline-block;
    background-color: #ffffff;
    color: #010205;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: #008EA7;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .itineraries-grid {
      grid-template-columns: 1fr;
    }
    .cta-box {
      padding: 40px 20px;
    }
  }
</style>