---
// src/pages/tours/koh-kradan-day-tour-from-phuket.astro

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const tour = {
  title: "Koh Kradan Day Tour from Phuket",
  description: "Embark on an unforgettable journey to one of the Andaman Sea’s most pristine islands. Immerse yourself in crystal-clear waters, vibrant coral reefs, and the tranquil beauty of Koh Kradan. Escape the crowds and dive into paradise.",
  priceAdult: "4,700",
  priceChild: "3,000",
  itinerary: [
    { time: "5:00 AM / 4:00 AM", title: "Morning Pick-Up", desc: "Pick-up from your hotel in Phuket (5:00 AM) or Khao Lak (4:00 AM). Transfer to Royal Phuket Marina for a 7:00 AM departure." },
    { time: "Morning", title: "Sunset Beach", desc: "Arrival at Koh Kradan. Unwind and soak up the stunning natural scenery of this peaceful stretch of sand." },
    { time: "Late Morning", title: "Snorkeling Adventure", desc: "Explore vibrant marine life with an unforgettable snorkeling session. Gear is provided." },
    { time: "Midday", title: "Paradise Beach", desc: "Follow a picturesque nature trail to this world-famous beach. Relax, swim, and enjoy the tropical setting." },
    { time: "Lunch", title: "Beachfront Dining", desc: "Enjoy a delicious Thai lunch at a restaurant on Paradise Beach with ocean views." },
    { time: "Afternoon", title: "Morakot Cave (Emerald Cave)", desc: "Journey to Koh Mook. Swim through an 80-meter tunnel to emerge into a hidden lagoon surrounded by limestone cliffs." },
    { time: "5:00 PM", title: "Return", desc: "Arrival back at Royal Phuket Marina and transfer to your hotel." }
  ]
};
---

<Layout title="Koh Kradan Day Tour | Luna Diving">
  <div class="pt-24 md:pt-28 max-w-4xl mx-auto px-6 pb-16 font-sans">
    
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-[#1A1A1A] mb-6">{tour.title}</h1>
      <p class="text-lg text-[#706F6F] leading-relaxed">{tour.description}</p>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-8">Itinerary</h2>
      <div class="space-y-4">
        {tour.itinerary.map((item) => (
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col md:flex-row md:items-center gap-4">
            <div class="md:w-1/4 font-bold text-[#008EA7] whitespace-nowrap">{item.time}</div>
            <div>
              <h3 class="font-bold text-[#1A1A1A]">{item.title}</h3>
              <p class="text-sm text-[#706F6F]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-[#1A1A1A] text-white p-8 rounded-[24px] mb-12">
      <h2 class="text-2xl font-bold mb-8 text-center">Price Per Person</h2>
      <div class="grid md:grid-cols-2 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceAdult}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Adult Price</div>
        </div>
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceChild}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Children (4 to 12 years)</div>
        </div>
      </div>
      <a 
        href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I%20would%20like%20to%20book%20the%20Koh%20Kradan%20Day%20Tour." 
        target="_blank"
        class="block mt-8 text-center bg-[#008EA7] text-white py-4 rounded-full font-bold hover:bg-[#007a90] transition-colors"
      >
        BOOK VIA WHATSAPP
      </a>
    </section>

    <section class="bg-white p-8 rounded-[24px] border border-gray-200">
      <h2 class="text-xl font-bold mb-6">What’s Included</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h4 class="font-bold mb-3">Tour Includes:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✓ Hotel transfers (Phuket & Khao Lak)</li>
            <li>✓ Light breakfast</li>
            <li>✓ National Park entrance fees</li>
            <li>✓ Tour guide (Multi-language)</li>
            <li>✓ Snorkeling gear</li>
            <li>✓ Lunch on the beach</li>
            <li>✓ Water, soft drinks, snacks & fruit</li>
            <li>✓ Full insurance</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-3">Not Included:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✗ Beach towel</li>
            <li>✗ Tips</li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</Layout>