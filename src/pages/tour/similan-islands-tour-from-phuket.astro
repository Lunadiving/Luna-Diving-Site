---
// src/pages/tours/early-morning-similan-island-tour.astro

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const tour = {
  title: "Early Morning Similan Island Tour from Phuket",
  description: "Discover the untouched paradise of the Similan Islands. This exclusive Early Bird tour allows you to experience Thailand’s most breathtaking islands before the crowds arrive. Enjoy powdery white sand beaches, stunning viewpoints, and vibrant snorkeling spots.",
  availability: "October 15th – May 15th",
  priceAdult: "4,300",
  priceChild: "2,850",
  itinerary: [
    { time: "4:00 AM / 5:00 AM", title: "Pick-up", desc: "Pick-up from Phuket (4:00 AM) or Khao Lak (5:00 AM). Transfer to Siam Pier (Namkhem)." },
    { time: "5:30 AM", title: "Arrival at Pier", desc: "Arrival at Siam Pier. Enjoy a light breakfast before boarding the speedboat." },
    { time: "7:00 AM", title: "Departure", desc: "Speedboat departure across the Andaman Sea." },
    { time: "7:45 AM", title: "Donald Duck Bay", desc: "Relax on white sandy beaches and enjoy the stunning scenery of Island No. 8." },
    { time: "8:30 AM", title: "Sail Rock Viewpoint", desc: "A short but rewarding hike offering spectacular panoramic views." },
    { time: "9:30 AM", title: "First Snorkeling Stop", desc: "Dive into the colorful underwater world of the Similan Islands." },
    { time: "11:00 AM", title: "Lunch", desc: "Enjoy a picnic lunch by the beach at Honeymoon Bay (Koh Miang)." },
    { time: "12:00 PM", title: "Nature Walk", desc: "A scenic 15-minute jungle walk to Princess Bay." },
    { time: "1:00 PM", title: "Second Snorkeling Stop", desc: "A final amazing underwater adventure." },
    { time: "2:30 PM", title: "Departure", desc: "Departure from the Similan Islands." },
    { time: "4:00 PM", title: "Return", desc: "Arrival at the pier and transfer back to your hotel." }
  ]
};
---

<Layout title="Early Morning Similan Island Tour | Luna Diving">
  <div class="pt-24 md:pt-28 max-w-4xl mx-auto px-6 pb-16 font-sans">
    
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-[#1A1A1A] mb-6">{tour.title}</h1>
      <p class="text-lg text-[#706F6F] leading-relaxed mb-4">{tour.description}</p>
      <div class="inline-block bg-[#008EA7]/10 text-[#008EA7] font-semibold px-4 py-2 rounded-lg text-sm">
        {tour.availability}
      </div>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-8">Itinerary</h2>
      <div class="space-y-4">
        {tour.itinerary.map((item) => (
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col md:flex-row md:items-center gap-4">
            <div class="md:w-1/4 font-bold text-[#008EA7] whitespace-nowrap">{item.time}</div>
            <div>
              <h3 class="font-bold text-[#1A1A1A]">{item.title}</h3>
              <p class="text-sm text-[#706F6F]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-[#1A1A1A] text-white p-8 rounded-[24px] mb-12">
      <h2 class="text-2xl font-bold mb-8 text-center">Price Per Person</h2>
      <div class="grid md:grid-cols-2 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceAdult}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Adult Price</div>
        </div>
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceChild}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Children (4 to 12 years)</div>
        </div>
      </div>
      <a 
        href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I%20would%20like%20to%20book%20the%20Early%20Morning%20Similan%20Island%20Tour." 
        target="_blank"
        class="block mt-8 text-center bg-[#008EA7] text-white py-4 rounded-full font-bold hover:bg-[#007a90] transition-colors"
      >
        BOOK VIA WHATSAPP
      </a>
    </section>

    <section class="bg-white p-8 rounded-[24px] border border-gray-200">
      <h2 class="text-xl font-bold mb-6">What’s Included</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h4 class="font-bold mb-3">Tour Includes:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✓ Hotel transfers (Khao Lak included, Phuket +400 THB)</li>
            <li>✓ Light breakfast & lunch</li>
            <li>✓ National park entrance fees</li>
            <li>✓ Professional tour guide</li>
            <li>✓ Snorkeling gear</li>
            <li>✓ Water, soft drinks, snacks & fresh fruit</li>
            <li>✓ Full insurance</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-3">Not Included:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✗ Beach towel</li>
            <li>✗ Tips</li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</Layout>