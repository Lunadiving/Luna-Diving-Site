---
// src/pages/tours/james-bond-island-tour-from-phuket.astro

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const tour = {
  title: "James Bond Island Tour from Phuket – Early Bird Experience",
  description: "Embark on an exclusive adventure to the breathtaking Phang Nga Bay before the crowds arrive. This early morning tour offers a peaceful and immersive experience, featuring hidden caves, limestone cliffs, canoeing, and iconic sights like James Bond Island and Koh Panyee.",
  availability: "All year round",
  priceAdult: "3,900",
  priceChild: "2,450",
  itinerary: [
    { time: "5:00 AM / 4:00 AM", title: "Pick-up", desc: "Pick-up from Phuket (5:00 AM) or Khao Lak (4:00 AM)." },
    { time: "5:30 AM", title: "Arrival at Marina", desc: "Arrival at Royal Phuket Marina – Enjoy a light breakfast before departure." },
    { time: "7:00 AM", title: "Speedboat Departure", desc: "Set off for Phang Nga Bay." },
    { time: "7:45 AM", title: "Panak Island", desc: "Explore hidden caves and lagoons on a walk-in tour." },
    { time: "8:30 AM", title: "James Bond Island", desc: "Visit the legendary Koh Tapu, made famous by The Man with the Golden Gun." },
    { time: "9:15 AM", title: "Samet Nangshe Viewpoint", desc: "Admire stunning panoramic views of Phang Nga Bay." },
    { time: "10:00 AM", title: "Canoeing Stop", desc: "Paddle through mangroves and sea caves at a private, crowd-free location." },
    { time: "11:00 AM", title: "Koh Panyee", desc: "Walk through this 200-year-old stilted fishing village and learn about its culture." },
    { time: "12:00 PM", title: "Lunch", desc: "Enjoy a delicious meal with local flavors at New Fern Restaurant." },
    { time: "1:30 PM", title: "Beach Stop", desc: "Relax on a secluded beach, swim, or sunbathe." }
  ]
};
---

<Layout title="James Bond Island Tour | Luna Diving">
  <div class="pt-24 md:pt-28 max-w-4xl mx-auto px-6 pb-16 font-sans">
    
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-[#1A1A1A] mb-6">{tour.title}</h1>
      <p class="text-lg text-[#706F6F] leading-relaxed">{tour.description}</p>
      <div class="mt-6 text-sm font-medium text-[#008EA7]">Availability: {tour.availability}</div>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-8">Itinerary</h2>
      <div class="space-y-4">
        {tour.itinerary.map((item) => (
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex flex-col md:flex-row md:items-center gap-4">
            <div class="md:w-1/4 font-bold text-[#008EA7] whitespace-nowrap">{item.time}</div>
            <div>
              <h3 class="font-bold text-[#1A1A1A]">{item.title}</h3>
              <p class="text-sm text-[#706F6F]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-[#1A1A1A] text-white p-8 rounded-[24px] mb-12">
      <h2 class="text-2xl font-bold mb-8 text-center">Price Per Person</h2>
      <div class="grid md:grid-cols-2 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceAdult}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Adult Price</div>
        </div>
        <div>
          <div class="text-3xl font-bold mb-1">฿{tour.priceChild}</div>
          <div class="text-sm uppercase tracking-wider opacity-80">Children (4 to 12 years)</div>
        </div>
      </div>
      <a 
        href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I%20would%20like%20to%20book%20the%20James%20Bond%20Island%20Tour." 
        target="_blank"
        class="block mt-8 text-center bg-[#008EA7] text-white py-4 rounded-full font-bold hover:bg-[#007a90] transition-colors"
      >
        BOOK VIA WHATSAPP
      </a>
    </section>

    <section class="bg-white p-8 rounded-[24px] border border-gray-200">
      <h2 class="text-xl font-bold mb-6">What’s Included</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h4 class="font-bold mb-3">Tour Includes:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✓ Hotel transfers (Phuket & Khao Lak)</li>
            <li>✓ Light breakfast & lunch</li>
            <li>✓ National park entrance fees</li>
            <li>✓ Professional tour guide</li>
            <li>✓ Canoe experience</li>
            <li>✓ Water, soft drinks, snacks & fresh fruit</li>
            <li>✓ Full insurance</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-3">Not Included:</h4>
          <ul class="text-sm text-[#706F6F] space-y-2">
            <li>✗ Beach towel</li>
            <li>✗ Tips</li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</Layout>