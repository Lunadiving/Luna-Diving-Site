---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us | Luna Diving Thailand & Phuket Yacht Charters">
  <main class="main-wrapper" id="theme-wrapper">

    <!-- HERO SECTION -->
    <section class="hero-container" aria-labelledby="contact-hero-title">
      <img
        src="/images/hero/hero-poster.webp"
        alt="Contact Luna Diving in Thailand"
        width="1200"
        height="650"
        fetchpriority="high"
        decoding="async"
        class="hero-poster"
      />
      <div class="video-overlay"></div>

      <div class="hero-content">
        <h1 id="contact-hero-title" class="hero-title animated-element fade-in-second">
          Get in Touch With Us
        </h1>
        <p class="hero-subtitle animated-element fade-in-third">
          Have questions about our liveaboard cruises, private yacht charters, or PADI scuba diving courses? Our team is ready to help plan your Andaman Sea adventure.
        </p>
      </div>
    </section>

    <!-- CONTACT DETAILS & INFO GRID -->
    <section class="contact-section" aria-labelledby="contact-info-title">
      <div class="contact-grid-container">
        
        <!-- Left Column: Direct Contact Info -->
        <div class="contact-info-box">
          <h2 id="contact-info-title" class="contact-heading">Contact Information</h2>
          <p class="contact-desc">
            Reach out to us directly via WhatsApp for the fastest response, or drop by our office in Phuket.
          </p>

          <ul class="contact-details-list">
            <li>
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <strong>Phone / WhatsApp</strong>
                <a href="https://wa.me/66918233120" target="_blank" rel="noopener noreferrer">+66 91 823 3120</a>
              </div>
            </li>

            <li>
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <strong>Email</strong>
                <a href="mailto:info@luna-diving-thailand.com">info@luna-diving-thailand.com</a>
              </div>
            </li>

            <li>
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <strong>Location</strong>
                <span>27/15 soi Pattana, Rawai, Phuket</span>
              </div>
            </li>
          </ul>

          <div class="whatsapp-box-banner">
            <h3>Quickest Response?</h3>
            <p>Click below to chat instantly with our booking agents on WhatsApp.</p>
            <a href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I%20have%20an%20inquiry." target="_blank" rel="noopener noreferrer" class="whatsapp-direct-btn">
              Chat on WhatsApp Now
            </a>
          </div>
        </div>

        <!-- Right Column: Inquiry Form / Message Box -->
        <div class="contact-form-box">
          <h2 class="contact-heading">Send Us a Message</h2>
          <p class="contact-desc">
            Fill out the form below and our team will get back to you within 24 hours.
          </p>

          <form id="contact-form" class="inquiry-form">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required placeholder="Your Name" />
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="your.email@example.com" />
            </div>

            <div class="form-group">
              <label for="service">Interested Service</label>
              <select id="service" name="service">
                <option value="Similan Liveaboard Cruises">Similan Liveaboard Cruises</option>
                <option value="Private Yacht Charter">Private Yacht Charter</option>
                <option value="PADI Scuba Diving Courses">PADI Scuba Diving Courses</option>
                <option value="Daily Dive Trips">Daily Dive Trips</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Your Message</label>
              <textarea id="message" name="message" rows="5" required placeholder="Tell us about your dates, number of guests, or specific questions..."></textarea>
            </div>

            <button type="submit" id="submit-btn" class="submit-btn">Send Message</button>
            <p id="form-status" style="margin-top: 1rem; display: none; font-size: 0.9rem; font-weight: 600;"></p>
          </form>
        </div>

      </div>
    </section>

    <!-- FLOATING WHATSAPP BUTTON -->
    <a
      href="https://wa.me/66918233120?text=Hi%20Luna%20Diving!%20I'm%20contacting%20you%20from%20your%20website."
      target="_blank"
      rel="noopener noreferrer"
      class="luna-whatsapp-floating"
      aria-label="Chat with Luna Diving on WhatsApp"
    >
      <svg class="whatsapp-icon-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusText = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) submitBtn.disabled = true;
      if (statusText) {
        statusText.style.display = 'block';
        statusText.style.color = '#333';
        statusText.textContent = 'Sending message...';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('/send-email.php', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.status === 'success') {
          if (statusText) {
            statusText.style.color = '#00b074';
            statusText.textContent = 'Thank you! Your message has been sent successfully.';
          }
          form.reset();
        } else {
          throw new Error(result.message || 'Error sending message');
        }
      } catch (error) {
        if (statusText) {
          statusText.style.color = '#ef4444';
          statusText.textContent = 'Failed to send message. Please try again or contact us via WhatsApp.';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .main-wrapper {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background-color: #ffffff;
    color: #111111;
    font-family: 'Inter', sans-serif;
  }

  /* HERO */
  .hero-container {
    position: relative;
    display: flex;
    min-height: 50vh;
    width: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    background: #0b131f;
  }

  .hero-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5,15,30,0.6) 0%, rgba(5,15,30,0.85) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 4rem 1.5rem;
  }

  .hero-title {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
  }

  .hero-subtitle {
    max-width: 700px;
    margin: 0 auto;
    color: #cbd5e1;
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    line-height: 1.6;
  }

  /* CONTACT SECTION GRID */
  .contact-section {
    max-width: 1300px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
  }

  .contact-grid-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-heading {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 0.8rem;
    color: #111;
  }

  .contact-desc {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  /* LEFT INFO BOX */
  .contact-info-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.5rem;
  }

  .contact-details-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-details-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 50%;
    color: #0c3562;
    flex-shrink: 0;
  }

  .contact-details-list strong {
    display: block;
    font-size: 0.85rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.2rem;
  }

  .contact-details-list span,
  .contact-details-list a {
    font-size: 1rem;
    color: #1e293b;
    text-decoration: none;
    font-weight: 600;
  }

  .contact-details-list a:hover {
    color: #0c3562;
    text-decoration: underline;
  }

  .whatsapp-box-banner {
    background: #0c1829;
    color: #ffffff;
    border-radius: 12px;
    padding: 1.8rem;
    text-align: center;
  }

  .whatsapp-box-banner h3 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }

  .whatsapp-box-banner p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0 0 1.2rem;
  }

  .whatsapp-direct-btn {
    display: inline-block;
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.8rem 1.8rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .whatsapp-direct-btn:hover {
    background: #20ba5a;
  }

  /* RIGHT FORM BOX */
  .contact-form-box {
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    background: #fff;
    color: #111;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #0c3562;
  }

  .submit-btn {
    background: #00b074;
    color: #ffffff;
    border: none;
    padding: 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 0.5rem;
  }

  .submit-btn:hover {
    background: #009662;
  }

  /* FLOATING WHATSAPP */
  .luna-whatsapp-floating {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 999;
    display: flex;
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .whatsapp-icon-svg {
    width: 32px;
    height: 32px;
  }

  /* ANIMATIONS */
  .animated-element {
    opacity: 0;
    transform: translateY(20px);
    animation: lunaFadeIn 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .fade-in-second { animation-delay: 300ms; }
  .fade-in-third { animation-delay: 600ms; }

  @keyframes lunaFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .contact-grid-container {
      grid-template-columns: 1fr;
    }
  }
</style>